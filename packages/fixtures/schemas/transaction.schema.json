{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://expense-tracker.local/schemas/transaction.schema.json",
  "title": "Transaction",
  "type": "object",
  "required": [
    "id",
    "vault_id",
    "occurred_on",
    "merchant_display",
    "amount_minor",
    "currency",
    "source_type",
    "review_state"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "vault_id": { "type": "string", "minLength": 1 },
    "occurred_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "merchant_display": { "type": "string", "minLength": 1 },
    "merchant_original": { "type": ["string", "null"] },
    "amount_minor": { "type": "integer" },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
    "category_id": { "type": ["string", "null"] },
    "category_source": { "enum": ["user", "personal_rule", "default_rule", "manual_required", null] },
    "category_confidence": { "enum": ["confirmed", "high", "medium", "low", "unresolved", null] },
    "note": { "type": ["string", "null"] },
    "source_type": { "enum": ["manual", "csv", "pdf", "demo"] },
    "statement_import_id": { "type": ["string", "null"] },
    "source_row_key": { "type": ["string", "null"] },
    "review_state": { "enum": ["confirmed", "needs_review", "excluded", "conflict"] },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "deleted_at": { "type": ["string", "null"] },
    "version": { "type": "integer", "minimum": 1 },
    "last_modified_by": { "enum": ["web", "ios", "relay", "importer"] }
  },
  "additionalProperties": false
}
