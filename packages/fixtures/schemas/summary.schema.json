{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://expense-tracker.local/schemas/summary.schema.json",
  "title": "SpendingSummary",
  "type": "object",
  "required": ["vault_id", "range", "total_spend_minor", "total_credits_minor", "net_activity_minor", "transaction_count", "category_totals"],
  "properties": {
    "vault_id": { "type": "string", "minLength": 1 },
    "range": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "end": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      },
      "additionalProperties": false
    },
    "total_spend_minor": { "type": "integer" },
    "total_credits_minor": { "type": "integer" },
    "net_activity_minor": { "type": "integer" },
    "transaction_count": { "type": "integer", "minimum": 0 },
    "category_totals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category_id", "spent_minor", "count"],
        "properties": {
          "category_id": { "type": "string" },
          "spent_minor": { "type": "integer" },
          "count": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
