{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://expense-tracker.local/schemas/snapshot.schema.json",
  "title": "SnapshotManifest",
  "type": "object",
  "required": ["snapshot_id", "vault_id", "device_id", "key_version", "created_at", "total_chunks", "checksum", "snapshot_checkpoint", "signature"],
  "properties": {
    "snapshot_id": { "type": "string", "minLength": 1 },
    "vault_id": { "type": "string", "minLength": 1 },
    "device_id": { "type": "string", "minLength": 1 },
    "key_version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "total_chunks": { "type": "integer", "minimum": 1 },
    "checksum": { "type": "string", "minLength": 1 },
    "snapshot_checkpoint": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "signature": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
